# ─────────────────────────────────────────────
#  SmartStay AI  •  .gitignore
#  Python / FastAPI / React / Vite / Docker
# ─────────────────────────────────────────────

# ── Python ───────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
MANIFEST
pip-wheel-metadata/
.installed.cfg

# ── Virtual environments ──────────────────────
.venv/
venv/
env/
ENV/
.env/
.conda/

# ── Environment / secrets ─────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.secret
secrets/

# ── Testing & coverage ────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
nosetests.xml
test-results/

# ── Type checking ─────────────────────────────
.mypy_cache/
.dmypy.json
.pytype/

# ── Jupyter ───────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Node / React / Vite ──────────────────────
node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.cache/
.cache/
*.local

# ── IDE / editors ────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/
*.suo
*.user
*.userosscache
*.sln.docobj
Thumbs.db
.DS_Store
Desktop.ini
$RECYCLE.BIN/

# ── Docker ────────────────────────────────────
*.override.yml

# ── Generated / runtime state ────────────────
data/                  # FAISS index, SQLite CRM, embeddings cache
calendars/             # iCalendar holds written at runtime
models/                # Piper / Moonshine model weights (large binaries)
*.onnx
*.onnx.json
eval_reports/          # Evaluation output (JSON, Markdown, SVG)

# ── Log files ─────────────────────────────────
*.log
logs/

# ── DeepEval / LLM eval caches ───────────────
.deepeval/

# ── OS-specific ───────────────────────────────
.DS_Store
Thumbs.db
ehtthumbs.db
desktop.ini
